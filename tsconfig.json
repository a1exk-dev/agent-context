{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "lib": ["esnext"],
        "types": ["node", "bun"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true
    },
    "include": ["scripts", "tests", "vitest.config.ts"],
    "exclude": ["tests/**/project", "tests/**/fixtures"]
}
